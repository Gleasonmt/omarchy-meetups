{
  "schemaVersion": 1,
  "id": "gleasonmt.meetups",
  "name": "Omarchy Meetups",
  "version": "0.1.0",
  "author": "Gleasonmt",
  "license": "MIT",
  "description": "The next Omarchy meetup near you in the bar, within a distance you choose, with every upcoming one a click away.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Omarchy Meetups",
    "description": "Next Omarchy meetup within your distance; click for the list.",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "radius": 100,
      "unit": "mi",
      "includeOnline": false,
      "hideWhenNone": false
    },
    "schema": [
      { "key": "radius", "type": "integer", "label": "Distance", "min": 5, "max": 5000, "step": 5, "defaultValue": 100, "description": "Show meetups within this distance of your weather location." },
      { "key": "unit", "type": "enum", "label": "Unit", "options": ["mi", "km"], "defaultValue": "mi" },
      { "key": "includeOnline", "type": "boolean", "label": "Include online meetups", "defaultValue": false },
      { "key": "hideWhenNone", "type": "boolean", "label": "Hide when none are nearby", "defaultValue": false }
    ]
  }
}
